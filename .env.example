# Optional overrides for compose.yaml. Copy to .env to use; every value
# below is the default Compose already uses without a .env file.

# Host port the app is served on: http://localhost:3000
FRONTEND_PORT=3000

# PostgreSQL credentials and database name (used by the db service and to
# build the backend's DATABASE_URL).
POSTGRES_USER=entities
POSTGRES_PASSWORD=entities
POSTGRES_DB=entities

# Insert sample Entities around Bandung on startup when the table is empty.
SEED=true
