# Serves the built app and forwards /api to the backend, so the browser
# talks to one origin and no CORS configuration is needed.
# ${BACKEND_URL} is filled in at container start by the nginx image's
# envsubst step (see Dockerfile).
server {
    listen 80;
    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Single-page app: unknown paths fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
